<?xml version="1.0"?>
<ruleset name="Quote Local Pickup Standards">
	<description>WordPress Coding Standards for Quote Local Pickup</description>
	
	<file>.</file>
	
	<!-- Exclude patterns -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/.git/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/docs/*</exclude-pattern>
	
	<!-- Arguments -->
	<arg value="sp"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	
	<!-- Rules -->
	<rule ref="WordPress">
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<!-- Check that the correct text domain is used in i18n functions. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="quote-local-pickup"/>
			</property>
		</properties>
	</rule>
	
	<!-- Prefixes -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ppqlp"/>
				<element value="PPQLP"/>
			</property>
		</properties>
	</rule>
</ruleset>
